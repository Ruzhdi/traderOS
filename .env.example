OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_DISPATCH_MAX_ATTEMPTS=5
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
