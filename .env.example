APP_NAME=TraderOS API
APP_ENV=local
DATABASE_URL=postgresql+psycopg://traderos:traderos@localhost:5432/traderos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
CELERY_BROKER_URL=redis://localhost:6379/0
CONTAINER_CELERY_BROKER_URL=redis://redis:6379/0
OUTBOX_DISPATCH_INTERVAL_SECONDS=10
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_DISPATCH_MAX_ATTEMPTS=5
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
OUTBOX_PUBLISHED_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30
OUTBOX_CLEANUP_BATCH_SIZE=500
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
