APP_NAME=TraderOS API
APP_ENV=local
DATABASE_URL=postgresql+psycopg://traderos:traderos@localhost:5432/traderos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
CELERY_BROKER_URL=redis://localhost:6379/0
